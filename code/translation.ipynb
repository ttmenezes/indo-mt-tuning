   "source": [
    "### Llama 3.2 1B"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "from openai import OpenAI\n",
    "\n",
    "client = OpenAI(\n",
    "  base_url = \"https://integrate.api.nvidia.com/v1\",\n",
    "  api_key = \"\"\n",
    ")\n",
    "\n",
    "def translate_llama_1B(source_text):\n",
    "    completion = client.chat.completions.create(\n",
    "    #   model=\"meta/llama-3.1-405b-instruct\",\n",
    "      model=\"meta/llama-3.2-1b-instruct\",\n",
    "      messages=[\n",
    "          {\"role\":\"user\",\"content\":\"Translate the following text from Javanese to Indonesian. Return only the translated text: \" + source_text}\n",
    "      ],\n",
    "      temperature=0,\n",
    "      top_p=0.7,\n",
    "      max_tokens=1024,\n",
    "      stream=False\n",
    "    )\n",
    "    return completion.choices[0].message.content\n"
   ]
  },
