    "### Llama 3.1 405B"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "url = \"https://api.hyperbolic.xyz/v1/chat/completions\"\n",
    "headers = {\n",
    "    \"Content-Type\": \"application/json\",\n"
    "}\n",
    "\n",
    "def translate_llama_405B(source_text):\n",
    "    data = {\n",
    "        \"messages\": [\n",
    "            {\n",
    "                \"role\": \"user\",\n",
    "                \"content\": \"Translate the following text from Javanese to Indonesian. Return only the Indonesian translated text: \" + source_text\n",
    "            }\n",
    "        ],\n",
    "        \"model\": \"meta-llama/Meta-Llama-3.1-405B-Instruct\",\n",
    "        \"max_tokens\": 2048,\n",
    "        \"temperature\": 0,\n",
    "        \"top_p\": 0.7\n",
    "    }\n",
    "      \n",
    "    response = requests.post(url, headers=headers, json=data)\n",
    "    return response.json()['choices'][0]['message']['content']"
   ]
