    "    ground_truth = pair['target']\n",
    "    \n",
    "    # Get the model's translation\n",
    "    generated = translate_cohere_aya_32B(javanese)\n",
    "    \n",
    "    # Store all texts\n",
    "    javanese_texts.append(javanese)\n",
    "    ground_truth_translations.append(ground_truth)\n",
