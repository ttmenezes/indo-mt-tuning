    "# get model and tokenizer from ft-models/llama-3.2-1b-sft-3 and push to hub\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
    "\n",
    "model = AutoModelForCausalLM.from_pretrained(\"../ft-models/llama-3.2-1b-sft-3\")\n",
    "tokenizer = AutoTokenizer.from_pretrained(\"../ft-models/llama-3.2-1b-sft-3\")\n",
    "\n",
    "# Test inference\n",
    "test_text = \"Iya bener, deknen lagi jaga warung.\"\n",
    "prompt = f\"### Input: Translate from Javanese to Indonesian: {test_text}\\n\\n### Response:\"\n",
    "\n",
    "inputs = tokenizer(prompt, return_tensors=\"pt\", padding=True, max_length=512)\n",
    "\n",
    "outputs = model.generate(\n",
    "    input_ids=inputs[\"input_ids\"],\n",
    "    attention_mask=inputs[\"attention_mask\"],\n",
    "    max_new_tokens=100,\n",
    "    do_sample=False,\n",
    "    pad_token_id=tokenizer.eos_token_id\n",
    ")\n",
    "\n",
    "result = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
    "print(\"Input:\", test_text)\n",
    "print(\"Translation:\", result.split(\"### Response:\")[-1].strip())\n",
    "\n",
    "\n",
    "# model.push_to_hub(\"llama-3.2-1b-sft-3\")\n",
    "# tokenizer.push_to_hub(\"llama-3.2-1b-sft-3\")\n",
    "# print(\"Model and tokenizer uploaded to hub\")\n"
