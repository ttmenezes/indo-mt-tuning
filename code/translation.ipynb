    "\n",
    "def process_translations():\n",
    "    prog = 0\n",
    "    # Create lists to store our data\n",
    "    javanese_texts = []\n",
    "    ground_truth_translations = []\n",
    "    generated_translations = []\n",
    "    # Create tasks for all translations\n",
    "    translation_pairs = list(load_translation_pairs())\n",
    "    \n",
    "    # Store source texts and ground truth\n",
    "    for pair in translation_pairs:\n",
    "        javanese_texts.append(pair['source'])\n",
    "        ground_truth_translations.append(pair['target'])\n",
    "        # Create task for translation\n",
    "        generated_translations.append(translate_gemma_3_4b_zero_shot(pair['source']))\n",
    "        prog += 1\n",
    "        print(f\"{prog}/{len(translation_pairs)}\")\n",
    "    \n",
    "\n",
    "    # Create a DataFrame\n",
    "    results_df = pd.DataFrame({\n",
    "        'javanese': javanese_texts,\n",
    "        'ground_truth': ground_truth_translations,\n",
    "        'generated': generated_translations\n",
    "    })\n",
    "\n",
    "    # Save to CSV\n",
    "    results_df.to_csv('translation_results_gemma_3_4b_zero_shot.csv', index=False)\n",
    "\n",
    "    # Display first few rows\n",
    "    print(results_df.head())\n",
    "\n",
    "# Run the code\n",
    "process_translations()"
   ]
